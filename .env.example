# ==========================================
# OPTIONAL API KEYS FOR CLIP SYNC (`npm run sync`)
# ==========================================
# Copy this file to `.env` if you want to enable any of these optional upgrades.
# None of these keys are required — `npm run sync` works out of the box without them!

# 1. YouTube Data API v3 Key (Optional)
# Without this, the YouTube adapter uses the public Atom feed + public Shorts tab.
# With this key, it queries the YouTube Data API for deeper video statistics and view sorting.
YOUTUBE_API_KEY=

# 2. Instagram Graph API oEmbed Token (Optional)
# Meta requires an App Token to call graph.facebook.com/v19.0/instagram_oembed.
# If omitted, Instagram URLs in watchlist.js still work using the URL + watchlist metadata.
INSTAGRAM_OEMBED_TOKEN=

# 3. Apify API Token (Optional — Paid 3rd-party service, disabled by default)
# Only needed if you configure a paid Apify dataset in src/config/sources.js.
APIFY_TOKEN=
